# Generate SECRET_KEY and stable ENCRYPTION_KEY before first startup.
SECRET_KEY=replace-with-a-random-secret
ENCRYPTION_KEY=replace-with-fernet-key
ADMIN_PASSWORD=replace-with-unique-password-at-least-10-characters
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
DATA_DIR=/data
HOST_METRICS=/metrics/host-metrics.json
HTTPS_ENABLED=false

# 用于向AI供应商提供1小时签名素材链接；必须为自己的HTTPS公网入口
PUBLIC_ORIGIN=https://studio.example.com
